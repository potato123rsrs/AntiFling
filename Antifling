--------------------------------------------------
-- Sistema de esquiva
--------------------------------------------------
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

local function filtrar(extra)
	local lista = {}

	if personagem then
		table.insert(lista, personagem)
	end

	if extra then
		table.insert(lista, extra)
	end

	params.FilterDescendantsInstances = lista
end

local function pontoLivre(origem, direcao, distancia)
	if workspace:Raycast(
		origem,
		direcao * (distancia + 1.5),
		params
	) then
		return nil
	end

	local destino = origem + direcao * distancia

	if not workspace:Raycast(
		destino,
		Vector3.new(0, -15, 0),
		params
	) then
		return nil
	end

	return destino
end

local marcados = {}

local function ameacaProxima(posicao)
	local melhor, melhorDist = nil, 25

	for _, outro in ipairs(Players:GetPlayers()) do
		local char = outro ~= jogador and outro.Character
		local r = char and char:FindFirstChild("HumanoidRootPart")

		if r then
			local d = (r.Position - posicao).Magnitude

			if marcados[char] then
				d *= 0.5
			end

			if d < melhorDist then
				melhor = char
				melhorDist = d
			end
		end
	end

	return melhor
end

local function flingerPerto(posicao)
	local agora = os.clock()

	for char, quando in pairs(marcados) do
		local r = char.Parent
			and char:FindFirstChild("HumanoidRootPart")

		if r and agora - quando < 0.5
			and (r.Position - posicao).Magnitude < DIST_FLINGER then
			return char
		end
	end

	return nil
end

local function iniciarEsquivo(ameacaForcada)
	local de = posicaoSegura
	local origem = de.Position
	local ameaca = ameacaForcada or ameacaProxima(origem)
	local ameacaRaiz = ameaca
		and ameaca:FindFirstChild("HumanoidRootPart")

	filtrar(ameaca)

	local frente

	if ameacaRaiz then
		local plano = (
			ameacaRaiz.Position - origem
		) * Vector3.new(1, 0, 1)

		if plano.Magnitude > 0.1 then
			frente = plano.Unit
		end
	end

	if not frente then
		local olhar = de.LookVector * Vector3.new(1, 0, 1)

		frente = olhar.Magnitude > 0.1
			and olhar.Unit
			or Vector3.new(0, 0, -1)
	end

	local direita = frente:Cross(Vector3.yAxis)
	local lado = math.random(0, 1) == 0 and -1 or 1

	local destino, direcao = origem, nil

	for _, d in ipairs({
		direita * lado,
		direita * -lado,
		-frente
	}) do
		local p = pontoLivre(origem, d, DISTANCIA_DESVIO)

		if p then
			destino = p
			direcao = d
			break
		end
	end

	local alvoOlhar = destino + frente

	if ameacaRaiz then
		alvoOlhar = Vector3.new(
			ameacaRaiz.Position.X,
			destino.Y,
			ameacaRaiz.Position.Z
		)
	end

	local para = (alvoOlhar - destino).Magnitude > 0.1
		and CFrame.lookAt(destino, alvoOlhar)
		or (CFrame.new(destino) * de.Rotation)

	local eixo, sinal = "y", lado

	if direcao then
		local lateral = para.RightVector:Dot(direcao)
		local frontal = para.LookVector:Dot(direcao)

		if math.abs(lateral) >= math.abs(frontal) then
			eixo = "z"
			sinal = lateral > 0 and -1 or 1
		else
			eixo = "x"
			sinal = frontal < 0 and 1 or -1
		end
	end

	desvio = {
		de = de,
		para = para,
		inicio = os.clock(),
		eixo = eixo,
		sinal = sinal
	}

	local chao = workspace:Raycast(
		origem,
		Vector3.new(0, -15, 0),
		params
	)

	local pe = chao
		and (chao.Position + Vector3.new(0, 0.15, 0))
		or (origem - Vector3.new(0, 3, 0))

	anel(CFrame.new(pe), 7, 0.45)
	faiscas(origem, 25, 22)
	mostrarEsquivo()
	filtroRapido(0.4)
	piscar(0.25, 0.2)
	tremer(0.04, 0.25)
	puloCamera()
	tocarSom(SOM_ESQUIVO, 1)

	if rastro then
		rastro.Enabled = true
	end
end

local function zerarVelocidade()
	raiz.AssemblyLinearVelocity = Vector3.zero
	raiz.AssemblyAngularVelocity = Vector3.zero
end

local function passoEsquivo(agora)
	local a = (agora - desvio.inicio) / DURACAO_DESVIO

	if a >= 1 then
		raiz.CFrame = desvio.para
		posicaoSegura = desvio.para
		desvio = nil
		travadoAte = agora + TEMPO_TRAVA

		task.delay(0.15, function()
			if rastro and not desvio then
				rastro.Enabled = false
			end
		end)
	else
		local e = 1 - (1 - a) ^ 3
		local volta = desvio.sinal * math.pi * 2 * suave(a)
		local giro, pulo

		if not ACROBACIA then
			pulo = math.sin(a * math.pi) * 0.8
			giro = CFrame.Angles(
				0,
				0,
				desvio.sinal
					* math.rad(30)
					* math.sin(a * math.pi)
			)
		elseif desvio.eixo == "z" then
			pulo = math.sin(a * math.pi) * ALTURA_PULO
			giro = CFrame.Angles(0, 0, volta)
		elseif desvio.eixo == "x" then
			pulo = math.sin(a * math.pi) * ALTURA_PULO
			giro = CFrame.Angles(volta, 0, 0)
		else
			pulo = math.sin(a * math.pi) * 1.2
			giro = CFrame.Angles(0, volta, 0)
		end

		raiz.CFrame = (
			desvio.de:Lerp(desvio.para, e)
			+ Vector3.new(0, pulo, 0)
		) * giro
	end

	zerarVelocidade()
end

--------------------------------------------------
-- Cancelar fling
--------------------------------------------------
local function cancelar()
	if not raiz or not raiz.Parent
		or not humanoide or not posicaoSegura then
		return
	end

	zerarVelocidade()
	raiz.CFrame = posicaoSegura
	humanoide.PlatformStand = false

	local estado = humanoide:GetState()

	if estado == Enum.HumanoidStateType.FallingDown
		or estado == Enum.HumanoidStateType.Ragdoll
		or estado == Enum.HumanoidStateType.Physics then
		humanoide:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end
end

local function guardarPosicao()
	posicaoSegura = raiz.CFrame

	if humanoide.FloorMaterial ~= Enum.Material.Air then
		posicaoChao = raiz.CFrame
	end
end

local function checar(dt)
	if not raiz or not raiz.Parent
		or not humanoide or humanoide.Health <= 0
		or not posicaoSegura then
		return
	end

	local vel = raiz.AssemblyLinearVelocity
	local giro = raiz.AssemblyAngularVelocity
	local pos = raiz.Position

	local quebrado = not (
		vel.Magnitude < math.huge
		and giro.Magnitude < math.huge
		and pos.Magnitude < math.huge
	)

	if not ligado or humanoide.SeatPart then
		desvio = nil

		if not quebrado then
			guardarPosicao()
		end

		return
	end

	local agora = os.clock()

	if desvio then
		passoEsquivo(agora)
		return
	end

	local horizontal = Vector3.new(
		vel.X, 0, vel.Z
	).Magnitude

	local salto = (pos - posicaoSegura.Position).Magnitude

	local limiteSalto = math.max(
		SALTO_MAX,
		(dt or 1 / 60) * SALTO_POR_SEGUNDO + 4
	)

	local noVoid =
		pos.Y < workspace.FallenPartsDestroyHeight + MARGEM_VOID

	if not quebrado and not noVoid
		and salto > limiteSalto
		and vel.Magnitude < VEL_TELEPORTE
		and giro.Magnitude < GIRO_MAX then
		guardarPosicao()
		travadoAte = 0
		return
	end

	local flingado = quebrado
		or noVoid
		or horizontal > HORIZONTAL_MAX
		or vel.Y > SUBIDA_MAX
		or giro.Magnitude > GIRO_MAX

	if not flingado
		and agora >= travadoAte
		and agora - ultimoEfeito > ESPERA_ESQUIVO then

		local flinger = flingerPerto(pos)

		if flinger then
			ultimoEfeito = agora
			guardarPosicao()
			iniciarEsquivo(flinger)
			return
		end
	end

	if flingado then
		if noVoid and posicaoChao then
			posicaoSegura = posicaoChao
		end

		cancelar()

		if agora - ultimoEfeito > ESPERA_ESQUIVO then
			ultimoEfeito = agora
			iniciarEsquivo()
		end

		travadoAte = agora + TEMPO_TRAVA

	elseif agora < travadoAte then
		cancelar()
	else
		guardarPosicao()
	end
end

--------------------------------------------------
-- Bloquear colisão dos flingadores localmente
--------------------------------------------------
local colisaoOriginal = setmetatable({}, {__mode = "k"})

local function devolverColisao(char)
	for _, p in ipairs(char:GetDescendants()) do
		if colisaoOriginal[p] then
			p.CanCollide = true
			colisaoOriginal[p] = nil
		end
	end
end

local function bloquearFlingers()
	local agora = os.clock()

	if ligado and BLOQUEAR_FLINGER then
		for _, outro in ipairs(Players:GetPlayers()) do
			local char = outro ~= jogador and outro.Character
			local r = char and char:FindFirstChild("HumanoidRootPart")

			if r then
				local v = r.AssemblyLinearVelocity.Magnitude
				local g = r.AssemblyAngularVelocity.Magnitude

				if g > GIRO_FLINGER
					or v > VEL_FLINGER
					or not (v < math.huge and g < math.huge) then
					marcados[char] = agora
				end
			end
		end
	end

	for char, quando in pairs(marcados) do
		if not char.Parent then
			marcados[char] = nil

		elseif agora - quando < 2 then
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") and p.CanCollide then
					colisaoOriginal[p] = true
					p.CanCollide = false
				end
			end

		else
			devolverColisao(char)
			marcados[char] = nil
		end
	end
end

--------------------------------------------------
-- Loop
--------------------------------------------------
conectar(RunService.Stepped, bloquearFlingers)
conectar(RunService.Heartbeat, checar)

--------------------------------------------------
-- Desligar tudo
--------------------------------------------------
_G.AntiFlingEsquivoParar = function()
	for _, c in ipairs(conexoes) do
		c:Disconnect()
	end

	pcall(function()
		RunService:UnbindFromRenderStep("AF_Esquivo_Desfaz")
	end)

	pcall(function()
		RunService:UnbindFromRenderStep("AF_Esquivo_Tremor")
	end)

	for char in pairs(marcados) do
		if char.Parent then
			devolverColisao(char)
		end
	end

	if rastro then
		if rastro.Attachment0 then
			rastro.Attachment0:Destroy()
		end

		if rastro.Attachment1 then
			rastro.Attachment1:Destroy()
		end

		rastro:Destroy()
	end

	if humanoide then
		humanoide:SetStateEnabled(
			Enum.HumanoidStateType.FallingDown,
			true
		)

		humanoide:SetStateEnabled(
			Enum.HumanoidStateType.Ragdoll,
			true
		)
	end

	pcall(aplicarAnimacoes, false)

	gui:Destroy()
	_G.AntiFlingEsquivoParar = nil
end

