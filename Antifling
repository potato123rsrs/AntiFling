	)
	p.Lifetime = NumberRange.new(0.25, 0.5)
	p.SpreadAngle = Vector2.new(180, 180)
	p.Drag = 4
	p.Rate = 0
	p.Parent = anexo
	p:Emit(quantidade)

	task.delay(0.8, function()
		anexo:Destroy()
	end)
end

local function filtroRapido(duracao)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = -0.8
	cc.Contrast = 0.2
	cc.TintColor = Color3.fromRGB(210, 230, 255)
	cc.Parent = Lighting

