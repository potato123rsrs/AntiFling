
-- Anti-Fling + Soco
-- Delta / Roblox mobile
-- Fling defensivo + contra-ataque visual
-- O efeito local nao garante knockback replicado.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local LP = Players.LocalPlayer
local PG = LP:WaitForChild("PlayerGui")

local old = PG:FindFirstChild("AntiFlingSoco")
if old then old:Destroy() end

local antiOn = false
local punchOn = false
local lastPunch = 0
local cooldown = 0.7
local char, hum, root
local safePivot

local gui = Instance.new("ScreenGui")
gui.Name = "AntiFlingSoco"
gui.ResetOnSpawn = false
gui.DisplayOrder = 9999
gui.Parent = PG

local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(245, 165)
panel.Position = UDim2.new(0, 15, 0.35, 0)
panel.BackgroundColor3 = Color3.fromRGB(24, 27, 38)
panel.BorderSizePixel = 0
panel.Parent = gui

Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 32)
title.BackgroundTransparency = 1
title.Text = "ANTI-FLING + SOCO"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 15
title.Parent = panel

local function makeButton(text, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 42)
    b.Position = UDim2.fromOffset(10, y)
    b.BackgroundColor3 = Color3.fromRGB(60, 64, 80)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.Text = text
    b.Parent = panel
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    return b
end

local flingBtn = makeButton("Ativar Fling: OFF", 38)
local punchBtn = makeButton("Ativar Soco: OFF", 87)

local info = Instance.new("TextLabel")
info.Position = UDim2.fromOffset(6, 133)
info.Size = UDim2.new(1, -12, 0, 25)
info.BackgroundTransparency = 1
info.Text = "Pronto"
info.TextColor3 = Color3.fromRGB(205, 210, 225)
info.TextSize = 11
info.Font = Enum.Font.Gotham
info.Parent = panel

local function updateButtons()
    flingBtn.Text = "Ativar Fling: " .. (antiOn and "ON" or "OFF")
    flingBtn.BackgroundColor3 = antiOn
        and Color3.fromRGB(35, 140, 90)
        or Color3.fromRGB(60, 64, 80)

    punchBtn.Text = "Ativar Soco: " .. (punchOn and "ON" or "OFF")
    punchBtn.BackgroundColor3 = punchOn
        and Color3.fromRGB(190, 65, 50)
        or Color3.fromRGB(60, 64, 80)
end

local function bindCharacter(c)
    char = c
    hum = c:WaitForChild("Humanoid")
    root = c:WaitForChild("HumanoidRootPart")
    safePivot = c:GetPivot()
end

if LP.Character then
    task.spawn(bindCharacter, LP.Character)
end
LP.CharacterAdded:Connect(bindCharacter)

flingBtn.Activated:Connect(function()
    antiOn = not antiOn
    info.Text = antiOn and "Protecao ativada" or "Protecao desligada"
    updateButtons()
end)

punchBtn.Activated:Connect(function()
    punchOn = not punchOn
    info.Text = punchOn and "Contra-ataque ativado" or "Contra-ataque desligado"
    updateButtons()
end)

-- Protege seu personagem contra velocidades e giros extremos.
RunService.Heartbeat:Connect(function()
    if not antiOn or not char or not char.Parent
    or not root or not root.Parent then
        return
    end

    local speed = root.AssemblyLinearVelocity.Magnitude
    local spin = root.AssemblyAngularVelocity.Magnitude

    if speed > 180 or spin > 150 or root.Position.Y < -100 then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)

        if safePivot and (
            (root.Position - safePivot.Position).Magnitude > 45
            or root.Position.Y < -100
        ) then
            pcall(function()
                char:PivotTo(safePivot)
            end)
        end

        if hum then
            pcall(function()
                hum.Sit = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end

        info.Text = "Movimento anormal detectado"
    elseif speed < 80 and spin < 60 and root.Position.Y > -80 then
        safePivot = char:GetPivot()
    end
end)

-- Busca um jogador proximo e na frente.
local function findTarget()
    if not root then return nil end

    local best, bestDistance = nil, 10

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local th = p.Character:FindFirstChildOfClass("Humanoid")
            local tr = p.Character:FindFirstChild("HumanoidRootPart")

            if th and tr and th.Health > 0 then
                local delta = tr.Position - root.Position
                local distance = delta.Magnitude

                if distance > 0 and distance < bestDistance then
                    if root.CFrame.LookVector:Dot(delta.Unit) > 0.1 then
                        best = p
                        bestDistance = distance
                    end
                end
            end
        end
    end

    return best
end

local function punchEffect(target)
    local tr = target.Character
        and target.Character:FindFirstChild("HumanoidRootPart")
    if not tr then return end

    local hl = Instance.new("Highlight")
    hl.Adornee = target.Character
    hl.FillColor = Color3.fromRGB(255, 45, 35)
    hl.OutlineColor = Color3.fromRGB(255, 220, 100)
    hl.FillTransparency = 0.3
    hl.Parent = Workspace
    Debris:AddItem(hl, 0.5)

    local ring = Instance.new("Part")
    ring.Shape = Enum.PartType.Ball
    ring.Size = Vector3.new(1, 1, 1)
    ring.CFrame = tr.CFrame
    ring.Anchored = true
    ring.CanCollide = false
    ring.CanTouch = false
    ring.Material = Enum.Material.Neon
    ring.Color = Color3.fromRGB(255, 75, 35)
    ring.Transparency = 0.15
    ring.Parent = Workspace

    TweenService:Create(
        ring,
        TweenInfo.new(0.35, Enum.EasingStyle.Quad),
        {
            Size = Vector3.new(9, 9, 9),
            Transparency = 1
        }
    ):Play()
    Debris:AddItem(ring, 0.4)

    local camera = Workspace.CurrentCamera
    if camera then
        local oldFov = camera.FieldOfView
        TweenService:Create(camera, TweenInfo.new(0.1), {
            FieldOfView = math.min(oldFov + 5, 90)
        }):Play()

        task.delay(0.15, function()
            if camera and camera.Parent then
                TweenService:Create(camera, TweenInfo.new(0.2), {
                    FieldOfView = oldFov
                }):Play()
            end
        end)
    end

    info.Text = "Impacto visual: " .. target.Name
end

local function tryPunch()
    if not punchOn or os.clock() - lastPunch < cooldown then
        return
    end
    lastPunch = os.clock()

    local target = findTarget()
    if target then
        punchEffect(target)
    else
        info.Text = "Nenhum alvo proximo a frente"
    end
end

UIS.InputBegan:Connect(function(input, processed)
    if not punchOn then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        -- Ignora toques nos botoes do painel.
        local pos = input.Position
        local objects = PG:GetGuiObjectsAtPosition(pos.X, pos.Y)
        for _, obj in ipairs(objects) do
            if obj:IsDescendantOf(panel) then
                return
            end
        end

        tryPunch()
    end
end)

updateButtons()
print("Anti-Fling + Soco carregado")
