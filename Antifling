local function suave(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local conexoes = {}

local function conectar(sinal, funcao)
	local c = sinal:Connect(funcao)
	table.insert(conexoes, c)
	return c
end

local function prepararHumanoide()
	if not humanoide then return end

	humanoide:SetStateEnabled(
		Enum.HumanoidStateType.FallingDown,
		not ligado
	)
	humanoide:SetStateEnabled(
		Enum.HumanoidStateType.Ragdoll,
		not ligado
	)
end

--------------------------------------------------
-- Aplicar e restaurar animações
--------------------------------------------------
local idsOriginais = setmetatable({}, {__mode = "k"})

local function aplicarAnimacoes(ativar)
	if not TROCAR_ANIMACOES then return end

	local char, hum = personagem, humanoide
	if not char or not hum
		or hum.RigType ~= Enum.HumanoidRigType.R15 then
		return
	end

	local animate = char:WaitForChild("Animate", 5)
	if not animate then return end

	local mudou = false

	for nome, id in pairs(ANIMACOES_AURA) do
		local pasta = animate:FindFirstChild(nome)

		if pasta then
			for _, anim in ipairs(pasta:GetChildren()) do
				if anim:IsA("Animation") then
					local novoId

					if type(id) == "table" then
						novoId = id[anim.Name]
					else
						novoId = id
					end

					if novoId and ativar then
						if idsOriginais[anim] == nil then
							idsOriginais[anim] = anim.AnimationId
						end

						anim.AnimationId =
							"rbxassetid://" .. tostring(novoId)

						mudou = true

					elseif not ativar and idsOriginais[anim] then
						anim.AnimationId = idsOriginais[anim]
						idsOriginais[anim] = nil
						mudou = true
					end
				end
			end
		end
	end

	if not mudou then return end

	local animator = hum:FindFirstChildOfClass("Animator")

	if animator then
		for _, trilha in ipairs(
			animator:GetPlayingAnimationTracks()
		) do
			local p = trilha.Priority

			if p == Enum.AnimationPriority.Core
				or p == Enum.AnimationPriority.Idle
				or p == Enum.AnimationPriority.Movement then
				trilha:Stop(0.15)
			end
		end
	end

	pcall(function()
		animate.Disabled = true
		task.wait()
		animate.Disabled = false
	end)
end

