local function parteEfeito()
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = COR
	return p
end

local function anel(cf, raioFinal, duracao)
	local N = 14
	local info = TweenInfo.new(
		duracao,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	for i = 1, N do
		local ang = (i / N) * math.pi * 2
		local giro = CFrame.Angles(0, -ang, 0)

		local dirLocal = Vector3.new(
			math.cos(ang), 0, math.sin(ang)
		)

		local p = parteEfeito()
		p.Size = Vector3.new(
			0.3, 0.3, 2 * math.pi * 0.6 / N * 1.2
		)

		p.CFrame = cf * CFrame.new(dirLocal * 0.6) * giro
		p.Transparency = 0.1
		p.Parent = workspace

		TweenService:Create(
			p,
			info,
			{
				CFrame = cf
					* CFrame.new(dirLocal * raioFinal)
					* giro,
				Size = Vector3.new(
					0.15, 0.15,
					2 * math.pi * raioFinal / N * 1.2
				),
				Transparency = 1
			}
		):Play()

		task.delay(duracao + 0.05, function()
			p:Destroy()
		end)
	end
end

local function faiscas(posicao, quantidade, velocidade)
	local anexo = Instance.new("Attachment")
	anexo.Position = posicao
	anexo.Parent = workspace.Terrain

	local p = Instance.new("ParticleEmitter")
	p.Color = ColorSequence.new(COR)
	p.LightEmission = 1
	p.Size = NumberSequence.new(0.35, 0)
	p.Speed = NumberRange.new(
		velocidade * 0.6,
