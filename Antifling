--------------------------------------------------
-- Tremor de câmera
--------------------------------------------------
local tremorForca, tremorDur, tremorAte = 0, 1, 0
local offsetAnterior = CFrame.identity

local function tremer(forca, duracao)
	tremorForca = forca
	tremorDur = duracao
	tremorAte = os.clock() + duracao
end

RunService:BindToRenderStep(
	"AF_Esquivo_Desfaz",
	Enum.RenderPriority.Camera.Value - 1,
	function()
		local cam = workspace.CurrentCamera

		if cam and offsetAnterior ~= CFrame.identity then
			cam.CFrame = cam.CFrame * offsetAnterior:Inverse()
		end

		offsetAnterior = CFrame.identity
	end
)

RunService:BindToRenderStep(
	"AF_Esquivo_Tremor",
	Enum.RenderPriority.Camera.Value + 2,
	function()
		local cam = workspace.CurrentCamera
		local restante = tremorAte - os.clock()

		if not cam or restante <= 0 then return end

		local f = tremorForca * (restante / tremorDur)

		local offset = CFrame.Angles(
			(math.random() - 0.5) * f,
			(math.random() - 0.5) * f,
			(math.random() - 0.5) * f * 0.5
		)

		cam.CFrame = cam.CFrame * offset
		offsetAnterior = offset
	end
)

